# Copy to .env and change what you need. Every setting is optional.

# HTTP server
PORT=3000
HOST=127.0.0.1

# Database. Leave DATABASE_URL empty to use the embedded Postgres (no install needed).
# With Docker (see docker-compose.yml):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lead_intake
DATABASE_URL=
DATA_DIR=data
EMBEDDED_PG_PORT=25432

# Webhook secrets, one per channel (at least 16 characters). Left empty, the
# gateway uses public demo secrets and says so in the log; with NODE_ENV=production
# it refuses to start without them.
WEBHOOK_SECRET_FORM=
WEBHOOK_SECRET_EMAIL=
WEBHOOK_SECRET_WHATSAPP=
WEBHOOK_SECRET_PORTAL=

# A signed webhook older or newer than this many seconds is refused (replay protection).
SIGNATURE_TOLERANCE_SEC=300
# Per channel and caller: RATE_LIMIT_BURST requests at once, then RATE_LIMIT_PER_SEC a second.
RATE_LIMIT_PER_SEC=20
RATE_LIMIT_BURST=40
BODY_LIMIT_BYTES=262144

# Jobs processed at the same time by the worker.
WORKER_CONCURRENCY=4
# "all" runs the HTTP server and the workers. "worker" runs only the workers:
# an extra process sharing the same queue (it needs DATABASE_URL to the same Postgres).
ROLE=all

# Logs: trace, debug, info, warn, error. LOG_PRETTY=1 forces readable lines, 0 forces JSON.
LOG_LEVEL=info
# LOG_PRETTY=1

# AI classification. "recorded" (default) replays real answers saved in
# fixtures/ai/recorded.json: no key, no cost. "live" calls Claude and needs
# ANTHROPIC_API_KEY (put it only in .env, which git ignores).
AI_MODE=recorded
AI_MODEL=claude-haiku-5-5
# Below this confidence (0 to 1) a person reviews the lead.
AI_MIN_CONFIDENCE=0.7
ANTHROPIC_API_KEY=

# CRM delivery. By default the fake CRM (npm run crm) on port 4010.
CRM_URL=http://127.0.0.1:4010
# A CRM call with no answer after this many ms is a timeout, and is retried.
CRM_TIMEOUT_MS=3000
# Our own speed limit towards the CRM, kept under the CRM's (the fake one allows 10/s).
CRM_RATE_LIMIT_PER_SEC=5
CRM_RATE_LIMIT_BURST=5
DELIVERY_CONCURRENCY=4
# A delivery whose worker died is taken by another worker after this many ms.
DELIVERY_LEASE_MS=30000
# Attempts before a delivery goes to the dead-letter, and the backoff between them
# (base x 2^(attempt-1), up to the max, with full jitter).
DELIVERY_MAX_ATTEMPTS=10
DELIVERY_BACKOFF_BASE_MS=1000
DELIVERY_BACKOFF_MAX_MS=600000
# Failures in a row that open the circuit breaker, and how long it stays open
# before one trial delivery.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=15000

# Bearer token for the approval console (http://127.0.0.1:3000), GET /dead-letter
# and POST /replay (npm run replay uses it). Left empty, a public demo token is
# used; with NODE_ENV=production it is required.
ADMIN_TOKEN=
# Where approved replies are written, one JSON file each. Nothing is ever sent.
OUTBOX_DIR=outbox
