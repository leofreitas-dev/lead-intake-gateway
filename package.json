{
  "name": "lead-intake-gateway",
  "version": "0.1.0",
  "description": "Receives leads from every channel, stores them before answering, and delivers each one to the CRM exactly once, even when the CRM is down.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "demo": "node src/cli/demo.ts",
    "send": "node src/cli/send.ts",
    "db:migrate": "node src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "fastify": "^5.12.8",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.6.0-beta.19",
    "@embedded-postgres/darwin-x64": "18.6.0-beta.19",
    "@embedded-postgres/linux-arm64": "18.6.0-beta.19",
    "@embedded-postgres/linux-x64": "18.6.0-beta.19",
    "@embedded-postgres/windows-x64": "18.6.0-beta.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/darwin-x64@18.6.0-beta.19": true,
    "@embedded-postgres/darwin-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
